{
  "name": "relay-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/poc-web",
    "services/poc-api",
    "services/api",
    "services/staging-api",
    "packages/ui",
    "packages/domain",
    "packages/contracts",
    "services/application",
    "services/agent-runtime",
    "packages/supplier-sdk"
  ],
  "scripts": {
    "start:local": "npm start --workspace @relay/poc-api",
    "start:poc": "npm start --workspace @relay/poc-api",
    "start:staging": "node services/staging-api/src/server.cjs",
    "test": "node --test --test-concurrency=2 packages/ui/test/*.test.cjs packages/domain/test/*.test.cjs packages/contracts/test/*.test.cjs services/api/test/*.test.cjs services/poc-api/test/*.test.cjs services/staging-api/test/*.test.cjs services/application/test/*.test.cjs services/agent-runtime/test/*.test.cjs packages/supplier-sdk/test/*.test.cjs services/link-runtime/test/*.test.cjs services/model-runtime/test/*.test.cjs services/connectors/test/*.test.cjs services/app-runtime/test/*.test.cjs services/operations/test/*.test.cjs",
    "test:staging": "npm test --workspace @relay/staging-api",
    "test:web": "npm test --workspace @relay/poc-web && npm test --workspace @relay/ui",
    "test:api": "npm test --workspace @relay/poc-api",
    "test:policy": "npm test --workspace @relay/api-policy",
    "test:contracts": "npm test --workspace @relay/contracts",
    "test:application": "node --test services/application/test/*.test.cjs",
    "model:local": "node services/scoping/scripts/serve-local.cjs",
    "eval:scoping": "node services/scoping/eval/run.cjs",
    "eval:agent": "node --test services/agent-runtime/test/*.test.cjs",
    "db:local:setup": "node services/application/scripts/local-postgres.cjs setup",
    "db:local:start": "node services/application/scripts/local-postgres.cjs start",
    "db:local:stop": "node services/application/scripts/local-postgres.cjs stop",
    "db:local:migrate": "node services/application/scripts/local-postgres.cjs migrate",
    "db:local:cutover": "node services/application/scripts/recovery.cjs cutover",
    "db:local:backup": "node services/application/scripts/recovery.cjs backup",
    "db:local:restore": "node services/application/scripts/recovery.cjs restore",
    "test:postgres": "node --test services/application/test/native/*.test.cjs",
    "eval:link": "node --test services/link-runtime/test/*.test.cjs",
    "storage:inspect": "node services/application/scripts/inspect-storage.cjs",
    "test:load": "node --test services/application/test/load/*.test.cjs",
    "storage:profile": "node services/application/scripts/profile-storage.cjs",
    "verify:local": "node services/operations/src/release-check.cjs",
    "membership:producer": "node services/staging-api/scripts/membership-producer.cjs",
    "membership:watchdog": "node services/staging-api/scripts/membership-watchdog.cjs",
    "membership:recovery": "node services/staging-api/scripts/membership-recovery.cjs",
    "membership:backup": "node services/application/scripts/membership-backup.cjs",
    "test:membership-backup": "node --test services/application/test/native/membership-backup.test.cjs"
  }
}
