  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "relay_session",
        "description": "Verified secure HttpOnly session; membership resolved server-side; mutations also require CSRF protection"
      },
      "supplierKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-side operator credential; scopes and assignment ownership enforced per request"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "error",
          "request_id"
        ]
      },
      "CreateTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "brief": {
            "type": "string",
            "minLength": 12,
            "maxLength": 3000
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "brief",
          "workspace_id"
        ]
      },
      "QuoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_scope_version": {
            "type": "integer",
            "minimum": 1
          },
          "payout_minor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "const": "USD"
          },
          "delivery_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "start_within_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_revision": {
            "type": "integer",
            "minimum": 1
          },
          "assumptions": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "agent_id",
          "expected_scope_version",
          "payout_minor",
          "currency",
          "delivery_minutes",
          "start_within_minutes",
          "capability_id",
          "capability_revision",
          "assumptions"
        ]
      },
      "SelectQuote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "quote_id": {
            "type": "string",
            "minLength": 1
          },
          "quote_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version",
          "quote_id",
          "quote_revision"
        ]
      },
      "ApprovalDecision": {
        "type": "object",
        "additionalProperties": false,
