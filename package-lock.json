{
  "name": "relay-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "relay-platform",
      "version": "0.1.0",
      "workspaces": [
        "apps/poc-web",
        "services/poc-api",
        "services/api",
        "packages/ui",
        "packages/domain",
        "packages/contracts"
      ]
    },
    "apps/poc-web": {
      "name": "@relay/poc-web",
      "version": "0.1.0"
    },
    "node_modules/@relay/api-policy": {
      "resolved": "services/api",
      "link": true
    },
    "node_modules/@relay/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@relay/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@relay/poc-api": {
      "resolved": "services/poc-api",
      "link": true
    },
    "node_modules/@relay/poc-web": {
      "resolved": "apps/poc-web",
      "link": true
    },
    "node_modules/@relay/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/contracts": {
      "name": "@relay/contracts",
      "version": "0.1.0"
    },
    "packages/domain": {
      "name": "@relay/domain",
      "version": "0.1.0"
    },
    "packages/ui": {
      "name": "@relay/ui",
      "version": "0.1.0"
    },
    "services/api": {
      "name": "@relay/api-policy",
      "version": "0.1.0",
      "dependencies": {
        "@relay/contracts": "0.1.0",
        "@relay/domain": "0.1.0"
      }
    },
    "services/poc-api": {
      "name": "@relay/poc-api",
      "version": "0.1.0",
      "engines": {
        "node": ">=24.0.0 <26"
      }
    }
  }
}
