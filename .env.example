# Server-only managed staging configuration. Real values belong in the host's
# secret manager or an ignored local environment file; never paste them in chat.
RELAY_APP_ORIGIN=https://YOUR-STAGING-HOST.onrender.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
SUPABASE_SECRET_KEY=replace-with-staging-server-secret-key
# Host-generated 32 random bytes encoded as hex or base64; not a human password.
RELAY_SESSION_KEY=replace-with-host-generated-encryption-key
